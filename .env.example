# Meta Graph API access token (required; server will not start without it)
META_ACCESS_TOKEN=

# Graph API version (optional, defaults to v21.0)
META_API_VERSION=

# Default ad account ID used when a tool call omits ad_account_id (optional)
META_DEFAULT_AD_ACCOUNT_ID=

# Host/port the MCP server binds to (optional, defaults to 127.0.0.1:8086)
BIND_HOST=
BIND_PORT=

# NOTE: in production these are supplied via `metaads-mcp.env`, per
# nixpacks.toml / .gitignore, not a generic `.env` file.
